OPENAI_API_KEY=
OPENAI_IMAGE_TIMEOUT_MS=120000

# Optional. When set, /api/chat proxies each user turn to Botpress.
# For local ADK dev, use BOTPRESS_RIZZBOT_ENDPOINT=http://localhost:3000 and set
# BOTPRESS_RIZZBOT_BOT_ID to the bot id shown by `adk dev`.
# Without BOTPRESS_RIZZBOT_BOT_ID, the endpoint should accept plain JSON:
# { matchId, profile, message, history } and return { reply }, { text }, or { message }.
BOTPRESS_RIZZBOT_ENDPOINT=
BOTPRESS_RIZZBOT_BOT_ID=
BOTPRESS_RIZZBOT_ACTION=rizzbotReply
BOTPRESS_RIZZBOT_TOKEN=
