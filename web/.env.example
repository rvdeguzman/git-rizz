OPENAI_API_KEY=

# Optional. When set, /api/chat proxies each user turn to your Botpress rizzbot endpoint.
# The endpoint should accept JSON: { matchId, profile, message, history }
# It may return { reply }, { text }, { message }, or { messages: [{ payload: { text } }] }.
BOTPRESS_RIZZBOT_ENDPOINT=
BOTPRESS_RIZZBOT_TOKEN=
